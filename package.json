{
	"name": "github-code-viewer",
	"version": "1.0.1",
	"author": "henzoparahua",
	"description": "Minimalist code viewer linking github repos to your notes.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^25.6.0",
		"esbuild": "0.28.0",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "17.4.0",
		"jiti": "2.6.1",
		"tslib": "2.8.1",
		"typescript": "^6.0.2",
		"typescript-eslint": "8.58.1"
	},
	"dependencies": {
		"obsidian": "latest",
		"shiki": "^4.0.2"
	}
}
